{
  "name": "backend",
  "version": "0.0.1",
  "description": "TypeScript + Express + Routing Controllers API Server",
  "author": "",
  "license": "ISC",
  "scripts": {
    "start": "dotenv -e .env.production.local node dist/server.js",
    "dev": "dotenv -e .env.development.local nodemon",
    "dev:test": "dotenv -e .env.test.local nodemon",
    "prisma": "dotenv -e .env.development.local -- prisma",
    "prisma:prod": "dotenv -e .env.production.local prisma",
    "prisma:migrate": "dotenv -e .env.development.local prisma migrate deploy",
    "prisma:seed": "dotenv -e .env.development.local ts-node prisma/seed/seed.ts",
    "prisma:generate": "dotenv -e .env.development.local prisma generate",
    "prisma:new-migrate": "dotenv -e .env.development.local yarn prisma migrate dev",
    "prisma:migrate:prod": "dotenv -e .env.production.local prisma migrate deploy",
    "prisma:seed:prod": "dotenv -e .env.production.local ts-node prisma/seed/seed.ts",
    "prisma:generate:prod": "dotenv -e .env.production.local prisma generate",
    "prisma:start": "yarn prisma:generate && yarn prisma:migrate && yarn prisma:seed:texts",
    "prisma:start:prod": "yarn prisma:generate:prod && yarn prisma:migrate:prod && yarn prisma:seed:texts:prod",
    "generate:contracts": "cross-env NODE_ENV=development ts-node ./src/swagger-typescript-api.ts",
    "build": "tsc && tsc-alias",
    "build:swc": "swc src -d dist --source-maps --copy-files",
    "test": "jest --forceExit --detectOpenHandles",
    "lint": "eslint src/",
    "lint:fix": "npm run lint -- --fix",
    "deploy:prod": "npm run build && pm2 start ecosystem.config.js --only prod",
    "deploy:dev": "pm2 start ecosystem.config.js --only dev"
  },
  "dependencies": {
    "@prisma/client": "^5.13.0",
    "axios": "^1.19.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "class-validator-jsonschema": "^5.1.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "dotenv-cli": "^8.0.0",
    "envalid": "^8.2.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "hpp": "^0.2.3",
    "lodash": "^4.18.1",
    "memorystore": "^1.6.8",
    "morgan": "^1.11.0",
    "multer": "^2.2.0",
    "passport": "^0.7.0",
    "passport-custom": "^1.2.1",
    "qs": "^6.15.3",
    "ra-data-simple-prisma": "5.3.0",
    "reflect-metadata": "^0.2.2",
    "routing-controllers": "^0.11.3",
    "routing-controllers-openapi": "^4.1.0",
    "sanitize-html": "^2.17.6",
    "session-file-store": "^1.5.0",
    "sharp": "^0.35.3",
    "swagger-ui-express": "^5.0.1",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0"
  },
  "devDependencies": {
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.15.47",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/helmet": "^4.0.0",
    "@types/hpp": "^0.2.7",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.19.4",
    "@types/passport": "^1.0.17",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/winston": "^2.4.4",
    "cross-env": "^7.0.3",
    "dayjs": "^1.11.21",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.3.0",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "prisma": "^5.22.0",
    "supertest": "^7.2.2",
    "swagger-typescript-api": "^13.12.6",
    "ts-jest": "^29.4.12",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  },
  "dependenciesComments": {
    "ra-data-simple-prisma": "Pinned to 5.3.0: from 5.4.0 the package imports react-admin at module load, which cannot be resolved in the Node backend. Keep the admin client on the same version as the backend handlers."
  }
}
